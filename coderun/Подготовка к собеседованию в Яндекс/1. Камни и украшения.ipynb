    "import sys\n",
    "\n",
    "\n",
    "def main():\n",
    "    drag = input()\n",
    "    st = input()\n",
    "\n",
    "    st = st.replace(drag,'1')\n",
    "    cnt = 0\n",
    "\n",
    "    for i in st:\n",
    "        if i == '1':\n",
    "            cnt += 1\n",
    "\n",
    "    print(cnt)\n",
    "\n",
    "    return cnt\n",
    "\n",
    "if __name__ == '__main__':\n",
    "    main()\n"
